{
	"name": "001_dataflow",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_adls_csv_orders_file",
						"type": "DatasetReference"
					},
					"name": "srcOrders"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_azure_db_orders",
						"type": "DatasetReference"
					},
					"name": "tgtOrders",
					"rejectedDataLinkedService": {
						"referenceName": "ls_adls",
						"type": "LinkedServiceReference"
					}
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          order_id as string,",
				"          customer_id as string,",
				"          product_id as string,",
				"          order_date as date 'yyyy-MM-dd',",
				"          quantity as short,",
				"          total_amount as double",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> srcOrders",
				"srcOrders sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> tgtOrders"
			]
		}
	}
}