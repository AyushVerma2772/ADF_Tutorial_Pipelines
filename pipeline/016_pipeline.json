{
	"name": "016_pipeline",
	"properties": {
		"description": "consolidate data from multiple folders and example of nested loops. \nFor nested loop use execute pipeline.",
		"activities": [
			{
				"name": "get metadata person person",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_alds_csv_persons",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "for country in person folder",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get metadata person person",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get metadata person person').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "set var_country_name",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_country_name",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "016_pipeline_a",
							"type": "ExecutePipeline",
							"dependsOn": [
								{
									"activity": "set var_country_name",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"pipeline": {
									"referenceName": "016_pipeline_a",
									"type": "PipelineReference"
								},
								"waitOnCompletion": true,
								"parameters": {
									"param_country_name": {
										"value": "@variables('var_country_name')",
										"type": "Expression"
									}
								}
							}
						}
					]
				}
			}
		],
		"variables": {
			"var_country_name": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-20T06:21:14Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}