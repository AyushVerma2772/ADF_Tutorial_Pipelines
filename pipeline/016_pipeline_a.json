{
	"name": "016_pipeline_a",
	"properties": {
		"description": "this pipeline will run inside the for loop for country",
		"activities": [
			{
				"name": "get metadata in current country folder",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "ds_alds_csv_persons_country",
						"type": "DatasetReference",
						"parameters": {
							"ds_param_country_name": {
								"value": "@pipeline().parameters.param_country_name",
								"type": "Expression"
							}
						}
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "for state in country",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "get metadata in current country folder",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('get metadata in current country folder').output.childItems",
						"type": "Expression"
					},
					"isSequential": true,
					"activities": [
						{
							"name": "Set var_state_name",
							"type": "SetVariable",
							"dependsOn": [],
							"policy": {
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"variableName": "var_state_name",
								"value": {
									"value": "@item().name",
									"type": "Expression"
								}
							}
						},
						{
							"name": "Copy data",
							"type": "Copy",
							"dependsOn": [
								{
									"activity": "Set var_state_name",
									"dependencyConditions": [
										"Succeeded"
									]
								}
							],
							"policy": {
								"timeout": "0.12:00:00",
								"retry": 0,
								"retryIntervalInSeconds": 30,
								"secureOutput": false,
								"secureInput": false
							},
							"userProperties": [],
							"typeProperties": {
								"source": {
									"type": "DelimitedTextSource",
									"additionalColumns": [
										{
											"name": "country",
											"value": {
												"value": "@pipeline().parameters.param_country_name",
												"type": "Expression"
											}
										},
										{
											"name": "state",
											"value": {
												"value": "@variables('var_state_name')",
												"type": "Expression"
											}
										}
									],
									"storeSettings": {
										"type": "AzureBlobFSReadSettings",
										"recursive": true,
										"wildcardFolderPath": {
											"value": "@concat('persons/', pipeline().parameters.param_country_name, '/', variables('var_state_name'), '/')",
											"type": "Expression"
										},
										"wildcardFileName": "*.csv",
										"enablePartitionDiscovery": false
									},
									"formatSettings": {
										"type": "DelimitedTextReadSettings"
									}
								},
								"sink": {
									"type": "AzureSqlSink",
									"writeBehavior": "insert",
									"sqlWriterUseTableLock": false
								},
								"enableStaging": false,
								"translator": {
									"type": "TabularTranslator",
									"typeConversion": true,
									"typeConversionSettings": {
										"allowDataTruncation": true,
										"treatBooleanAsNumber": false
									}
								}
							},
							"inputs": [
								{
									"referenceName": "ds_alds_csv_persons",
									"type": "DatasetReference"
								}
							],
							"outputs": [
								{
									"referenceName": "ds_azure_db",
									"type": "DatasetReference",
									"parameters": {
										"table_name": "persons"
									}
								}
							]
						}
					]
				}
			}
		],
		"parameters": {
			"param_country_name": {
				"type": "string"
			}
		},
		"variables": {
			"var_state_name": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-09-20T06:21:14Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}