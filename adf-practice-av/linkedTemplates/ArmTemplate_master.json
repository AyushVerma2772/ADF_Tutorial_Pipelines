{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-practice-av"
		},
		"ls_adls_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_adls'"
		},
		"ls_azure_db_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_azure_db'"
		},
		"ls_adls_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sapracticeav.dfs.core.windows.net/"
		},
		"ls_azure_db_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "server-practice-av.database.windows.net"
		},
		"ls_azure_db_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql_db_practice_av"
		},
		"ls_azure_db_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "ayush"
		},
		"ls_dummy_json_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/"
		},
		"trigger_orders_file_properties_026_pipeline_parameters_file_name": {
			"type": "string",
			"defaultValue": "orders.csv"
		},
		"trigger_orders_file_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/192d2855-2b3c-4dc5-a587-34f1c85efdc9/resourceGroups/rg_practice_av/providers/Microsoft.Storage/storageAccounts/sapracticeav"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-practice-av_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_adls_accountKey": {
						"value": "[parameters('ls_adls_accountKey')]"
					},
					"ls_azure_db_password": {
						"value": "[parameters('ls_azure_db_password')]"
					},
					"ls_adls_properties_typeProperties_url": {
						"value": "[parameters('ls_adls_properties_typeProperties_url')]"
					},
					"ls_azure_db_properties_typeProperties_server": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_server')]"
					},
					"ls_azure_db_properties_typeProperties_database": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_database')]"
					},
					"ls_azure_db_properties_typeProperties_userName": {
						"value": "[parameters('ls_azure_db_properties_typeProperties_userName')]"
					},
					"ls_dummy_json_properties_typeProperties_url": {
						"value": "[parameters('ls_dummy_json_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "adf-practice-av_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-practice-av_ArmTemplate_0')]"
			]
		},
		{
			"name": "adf-practice-av_ArmTemplate_2",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_2.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"trigger_orders_file_properties_026_pipeline_parameters_file_name": {
						"value": "[parameters('trigger_orders_file_properties_026_pipeline_parameters_file_name')]"
					},
					"trigger_orders_file_properties_typeProperties_scope": {
						"value": "[parameters('trigger_orders_file_properties_typeProperties_scope')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'adf-practice-av_ArmTemplate_1')]"
			]
		}
	]
}