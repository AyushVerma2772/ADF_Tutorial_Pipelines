{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-practice-av"
		},
		"trigger_orders_file_properties_026_pipeline_parameters_file_name": {
			"type": "string",
			"defaultValue": "orders.csv"
		},
		"trigger_orders_file_properties_typeProperties_scope": {
			"type": "string",
			"defaultValue": "/subscriptions/192d2855-2b3c-4dc5-a587-34f1c85efdc9/resourceGroups/rg_practice_av/providers/Microsoft.Storage/storageAccounts/sapracticeav"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/008_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "Lookup Transformation",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_csv_orders_file",
								"type": "DatasetReference"
							},
							"name": "srcOrders"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_csv_cust_file",
								"type": "DatasetReference"
							},
							"name": "srcCust"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_csv_output",
								"type": "DatasetReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "lookup"
						}
					],
					"scriptLines": [
						"source(output(",
						"          order_id as string,",
						"          customer_id as string,",
						"          product_id as string,",
						"          order_date as date,",
						"          quantity as short,",
						"          total_amount as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcOrders",
						"source(output(",
						"          customer_id as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          email as string,",
						"          city as string,",
						"          state as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcCust",
						"srcOrders, srcCust lookup(srcOrders@customer_id == srcCust@customer_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lookup",
						"lookup sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     filePattern:'orders_lookup_cust.csv',",
						"     umask: 0777,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          order_id,",
						"          customer_id = srcOrders@customer_id,",
						"          order_date,",
						"          quantity,",
						"          total_amount,",
						"          first_name,",
						"          last_name,",
						"          email,",
						"          city,",
						"          state",
						"     )) ~> sink"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/009_dataflow')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"description": "JoinTransformation",
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_adls_csv_orders_file",
								"type": "DatasetReference"
							},
							"name": "srcOrders"
						},
						{
							"dataset": {
								"referenceName": "ds_adls_csv_cust_file",
								"type": "DatasetReference"
							},
							"name": "srcCust"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_adls_csv_output",
								"type": "DatasetReference"
							},
							"name": "sink"
						}
					],
					"transformations": [
						{
							"name": "join"
						}
					],
					"scriptLines": [
						"source(output(",
						"          order_id as string,",
						"          customer_id as string,",
						"          product_id as string,",
						"          order_date as date,",
						"          quantity as short,",
						"          total_amount as double",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcOrders",
						"source(output(",
						"          customer_id as string,",
						"          first_name as string,",
						"          last_name as string,",
						"          email as string,",
						"          city as string,",
						"          state as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false) ~> srcCust",
						"srcOrders, srcCust join(srcOrders@customer_id == srcCust@customer_id,",
						"     joinType:'inner',",
						"     matchType:'exact',",
						"     ignoreSpaces: false,",
						"     broadcast: 'auto')~> join",
						"join sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     filePattern:'orders_join_cust.csv',",
						"     umask: 0777,",
						"     preCommands: [],",
						"     postCommands: [],",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     mapColumn(",
						"          order_id,",
						"          order_date,",
						"          quantity,",
						"          total_amount,",
						"          first_name,",
						"          last_name,",
						"          email,",
						"          city,",
						"          state",
						"     )) ~> sink"
					]
				}
			},
			"dependsOn": []
		},
