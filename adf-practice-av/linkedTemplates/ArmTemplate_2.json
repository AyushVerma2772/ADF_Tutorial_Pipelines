									"dependsOn": [
										{
											"activity": "set var_country_name",
											"dependencyConditions": [
												"Succeeded"
											]
										}
									],
									"policy": {
										"secureInput": false
									},
									"userProperties": [],
									"typeProperties": {
										"pipeline": {
											"referenceName": "016_pipeline_a",
											"type": "PipelineReference"
										},
										"waitOnCompletion": true,
										"parameters": {
											"param_country_name": {
												"value": "@variables('var_country_name')",
												"type": "Expression"
											}
										}
									}
								}
							]
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"variables": {
					"var_country_name": {
						"type": "String"
					}
